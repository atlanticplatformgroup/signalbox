  }
}

action dispatchIssueCreation @stableId("act_cbb72fd307704ab3927aa4bea8112fbf")(
  caller actor: Principal,
  request: IssueRequest,
  allowance: Allowance
) -> Execution {
  authorize
    actor.kind == PrincipalKind.AGENT
    and actor.status == PrincipalStatus.ACTIVE
    and Role.EXECUTOR in actor.roles
    and actor.org == request.org;
  require ready: request.status == RequestStatus.READY;
  require allowance_scope:
    allowance.org == request.org and allowance.agent == request.requestedBy;
  idempotency required;

  update request { status = RequestStatus.DISPATCHED; }
  create Execution {
    org = request.org;
    requestId = request.id;
    requestKind = RequestKind.ISSUE;
    requestedBy = request.requestedBy;
    connector = request.connector;
    allowance = allowance;
    status = ExecutionStatus.PENDING;
    externalReference = null;
    failureMessage = null;
  }
}

