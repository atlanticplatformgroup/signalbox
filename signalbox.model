// Signalbox — transactional interlocking for AI agent actions.
//
// Every protected operation is tenant-confined, caller-bound, idempotent, and
// represented by a typed request. Sensitive operations require an independent
// human approval before a connector worker may dispatch them.

model Signalbox version "0.51.0";

enum PrincipalKind @stableId("enm_943e2ecda4b34981aa0185964e8ebea1") {
  HUMAN @stableId("emv_efb2884e01154acc9e5ef1f0ed82ae38"),
  AGENT @stableId("emv_6ceac84fdd024ed9a99f98717db188f5")
}

enum PrincipalStatus @stableId("enm_b3eb770de22342738109ac1a6eba6d12") {
  ACTIVE @stableId("emv_342a2e9919724cf490eea833a409067b"),
  REVOKED @stableId("emv_9bb96442c5fb4a7eb09bdba6438cf103")
}

enum Role @stableId("enm_0be4ea379dd741439ed47dcaae9dd5fc") {
  MEMBER @stableId("emv_86658ec57f164a6aa3fcacffbc75de4e"),
  APPROVER @stableId("emv_42acb032e28f402aae0129d1b2da8fa0"),
  ADMIN @stableId("emv_9d8ee6584f95458392c0ac62647c3453"),
  EXECUTOR @stableId("emv_35c5d303f6bd42f486dddf689c14e3d9")
}

