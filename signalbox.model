  approver: Principal @immutable @stableId("fld_3cbd6c8ee8df4e4e90d1932ad237e9c2");
  approverRoles: Set<Role> @snapshot @stableId("fld_8c4149cd900c4ec0bfdc0a63df509394");

  invariant independent_approver @stableId("inv_fefea6c0eacc4527af9b15c27ba1487a"): approver != requestedBy;
  invariant approval_authority_recorded @stableId("inv_d69a838876bf4ab89b901d191b0ec820"): Role.APPROVER in approverRoles;
}

entity Execution @tenantScoped(org) @stableId("ent_695aab5599c84a78ac8f2ea75ccbdf1d") {
  id: UUID @id @generated(uuid) @immutable @stableId("fld_054965adb4f143f5a51c51d9449265b5");
  startedAt: DateTime @generated(now) @immutable @stableId("fld_21c95bb344a2454680073627dfd4a830");
  org: Organization @immutable @stableId("fld_38800d8c1ef74f46a314cdbf1ba6aed6");
  requestId: UUID @unique @stableId("fld_3bc7534978b84f1b81aad0e4cd9e629e");
  requestKind: RequestKind @immutable @stableId("fld_425a2eb8a4694f98a1d6b8b3271733f1");
  requestedBy: Principal @immutable @stableId("fld_00f8c8443450466f8f3491a6a4e61d8d");
  connector: Connector @immutable @stableId("fld_06f07c78abb442e4bbeb925fe1d5cf48");
  allowance: Allowance @unique @stableId("fld_3ab113e9fda24d89818dc798b47dc0bd");
  status: ExecutionStatus = ExecutionStatus.PENDING @stableId("fld_235cde6a26a7444582cce44bdb3e7524");
  externalReference: String? @stableId("fld_34eddd44213045eda0988a0ebb8729f8");
  failureMessage: String? @stableId("fld_c31f988db83b4854a999c67c86c3aea1");

  invariant result_matches_status @stableId("inv_53a63cda070d479e8394eee58596d4d4"):
    (
      status == ExecutionStatus.PENDING
      and externalReference == null
      and failureMessage == null
    )
    or
    (
      status == ExecutionStatus.SUCCEEDED
      and externalReference != null
      and failureMessage == null
    )
    or
    (
      status == ExecutionStatus.FAILED
      and externalReference == null
      and failureMessage != null
    );
}

policy IssueDelegation @stableId("pol_283b5ccf33154f469de3572557c213de")(
  actor: Principal,
  delegation: Delegation,
  repository: Repository,
  connector: Connector
) {
  allow active_scoped_agent @stableId("pbr_ba69b7197f1d46628c1b933973088326"):
    actor.kind == PrincipalKind.AGENT
    and actor.status == PrincipalStatus.ACTIVE
    and delegation.agent == actor
    and delegation.status == DelegationStatus.ACTIVE
    and delegation.capability == Capability.CREATE_ISSUE
    and delegation.repository == repository
    and delegation.connector == connector
    and repository.connector == connector
    and delegation.org == actor.org
    and repository.org == actor.org
    and connector.org == actor.org;
}

