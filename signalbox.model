  }
}

action approveProductionDeployment @stableId("act_047a601f15384b5ea4bfa05b5ef72676")(
  caller actor: Principal,
  request: DeploymentRequest
) -> Approval {
  authorize IndependentDeploymentApprover(actor, request);
  require production_request: request.environmentTier == EnvironmentTier.PRODUCTION;
  require awaiting_approval: request.status == RequestStatus.PENDING_APPROVAL;
  idempotency required;

  update request {
    status = RequestStatus.APPROVED;
    approvedBy = actor;
    approvedByRoles = actor.roles;
  }
  create Approval {
    org = request.org;
    requestId = request.id;
    requestKind = RequestKind.DEPLOYMENT;
    requestedBy = request.requestedBy;
    approver = actor;
    approverRoles = actor.roles;
  }
}

action rejectProductionDeployment @stableId("act_18ab026d358144dfa4d1729e40dd832e")(
  caller actor: Principal,
  request: DeploymentRequest
) -> DeploymentRequest {
  authorize IndependentDeploymentApprover(actor, request);
  require production_request: request.environmentTier == EnvironmentTier.PRODUCTION;
  require awaiting_approval: request.status == RequestStatus.PENDING_APPROVAL;
  idempotency required;

  update request {
    status = RequestStatus.REJECTED;
  }
}

action approveSchemaMigration @stableId("act_4c170dfcb0224cb8aaf078fe6b6ef23d")(
  caller actor: Principal,
  request: SchemaMigrationRequest
) -> Approval {
  authorize IndependentMigrationApprover(actor, request);
