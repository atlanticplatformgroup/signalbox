action completeExecution @stableId("act_5be24324b68d4c2eb334732b36e1b16c")(
  caller actor: Principal,
  execution: Execution,
  externalReference: String
) -> Execution {
  authorize
    actor.kind == PrincipalKind.AGENT
    and actor.status == PrincipalStatus.ACTIVE
    and Role.EXECUTOR in actor.roles
    and actor.org == execution.org;
  require pending: execution.status == ExecutionStatus.PENDING;
  idempotency required;

  update execution {
    status = ExecutionStatus.SUCCEEDED;
    externalReference = externalReference;
    failureMessage = null;
  }
}

action failExecution @stableId("act_926686163a6544e79d44dea9336d2c88")(
  caller actor: Principal,
  execution: Execution,
  failureMessage: String
) -> Execution {
  authorize
    actor.kind == PrincipalKind.AGENT
    and actor.status == PrincipalStatus.ACTIVE
    and Role.EXECUTOR in actor.roles
    and actor.org == execution.org;
  require pending: execution.status == ExecutionStatus.PENDING;
  idempotency required;

  update execution {
    status = ExecutionStatus.FAILED;
    externalReference = null;
    failureMessage = failureMessage;
  }
}

