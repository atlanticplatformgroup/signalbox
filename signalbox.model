  REJECTED @stableId("emv_1f9acbfbce954efbaff9c782a7e5af94"),
  DISPATCHED @stableId("emv_7dfcad253ae24f8b9b05598cd2c5b59e")
}

enum RequestKind @stableId("enm_15fd74a87ba3472b86d9f81a8e050e0a") {
  ISSUE @stableId("emv_0032cfced1f64d918096e4e5ea7b563b"),
  PULL_REQUEST @stableId("emv_694bc41d35744819a6bf49f2a81f4316"),
  DEPLOYMENT @stableId("emv_7407e28496c3430da0ad6f2fb339fea2"),
  SCHEMA_MIGRATION @stableId("emv_a29f27d325c14aa9b6bc2929f9ef71dd")
}

enum ExecutionStatus @stableId("enm_0b965e59e8ac496a9615959c4f1613b5") {
