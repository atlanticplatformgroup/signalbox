  audit reads;
}

query deploymentApprovalInbox @stableId("qry_21f24f72d72c4bb98df539477f0e81f2")(
  caller actor: Principal
) returns DeploymentRequestSummary from DeploymentRequest as request {
  authorize
    actor.kind == PrincipalKind.HUMAN
    and Role.APPROVER in actor.roles;
  where request.org == actor.org
    and request.environmentTier == EnvironmentTier.PRODUCTION
    and request.status == RequestStatus.PENDING_APPROVAL
    and request.requestedBy != actor;
  orderBy request.id asc;
  limit 50;
  paginate cursor;
  audit reads;
}

query mySchemaMigrationRequests @stableId("qry_e3c9ea88ab664e96a5eaf20efc8c94a9")(
  caller actor: Principal
) returns SchemaMigrationSummary from SchemaMigrationRequest as request {
  authorize true;
