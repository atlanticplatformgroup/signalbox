}

entity Principal @tenantScoped(org) @stableId("ent_197f12dacaf14992a367c5c15f895415") {
  id: UUID @id @generated(uuid) @immutable @stableId("fld_0f4346fb82a7470baa889475e5480797");
  org: Organization @immutable @stableId("fld_21bdc1e7c1a4408f8d0c56d3c73b6856");
  kind: PrincipalKind @immutable @stableId("fld_4494f33148d746dcb887d73be133b248");
  displayName: String @stableId("fld_a25b3b5aefbe4466a95b26a8edf32a28");
  status: PrincipalStatus = PrincipalStatus.ACTIVE @stableId("fld_72c4a69879134905b2c62f511514143f");
  roles: Set<Role> @stableId("fld_701810bb7b774ea4877941ecd35be293");
  responsibleOwner: Principal? @immutable @stableId("fld_eb710ade20f342e8a2115ca7e7561f0a");

  invariant agent_has_human_owner @stableId("inv_9d2a1ef4ee1b4eb89823a061089a72bb"):
    (kind == PrincipalKind.AGENT and responsibleOwner != null)
    or (kind == PrincipalKind.HUMAN and responsibleOwner == null);
}

// Plaintext Agent Access Tokens never enter the model. The host stores only a
// one-way hash plus lifecycle metadata, then binds a verified token to Principal.
entity AgentCredentialMetadata @stableId("ent_bc00926c5e9b40bd9fd939ef1ebb1a11") @tenantScoped(org) {
  id: UUID @id @generated(uuid) @immutable @stableId("fld_0319bfe549e14021b424663707e506b8");
  org: Organization @immutable @stableId("fld_d2d64cc1c1e547e5860ca57b9e89bd40");
  agent: Principal @immutable @stableId("fld_81fe0905512148f69ba6bf0363cc1beb");
  label: String @immutable @stableId("fld_85192ad23f4a42a6a03a8034610cd882");
  tokenHash: String @unique @immutable @stableId("fld_52c6b5c65d3342a1a003475262e51211");
  expiresAt: DateTime? @immutable @stableId("fld_0f0dfaac17d5484aa43eadabb6937d20");
  revokedAt: DateTime? @stableId("fld_5c738668ad2c40a59a88d1b6276868d5");
  lastUsedAt: DateTime? @stableId("fld_11227fd385794b719a913ee683b8e129");
}

