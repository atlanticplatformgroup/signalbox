policy IndependentDeploymentApprover @stableId("pol_08ab785a8747405bbdfeb05009a9df9d")(
  actor: Principal,
  request: DeploymentRequest
) {
  allow independent_approver @stableId("pbr_3c3833abc88242adb5090ed343f32057"):
    actor.kind == PrincipalKind.HUMAN
    and actor.status == PrincipalStatus.ACTIVE
    and Role.APPROVER in actor.roles
    and actor.org == request.org
    and actor != request.requestedBy;
}

policy IndependentMigrationApprover @stableId("pol_ee8441bff1214fbab3a420e3f02e899c")(actor: Principal, request: SchemaMigrationRequest) {
  allow independent_approver @stableId("pbr_099459e0688e4de4b44b6410cbfbe3a3"):
    actor.kind == PrincipalKind.HUMAN
    and actor.status == PrincipalStatus.ACTIVE
    and Role.APPROVER in actor.roles
    and actor.org == request.org
    and actor != request.requestedBy;
}

action requestIssueCreation @stableId("act_ea693a4d658449fbab5741b8369bc276")(
  caller actor: Principal,
  delegation: Delegation,
  repository: Repository,
  connector: Connector,
  title: String,
  body: String
) -> IssueRequest {
  authorize IssueDelegation(actor, delegation, repository, connector);
  idempotency required;

  create IssueRequest {
    org = actor.org;
    requestedBy = actor;
    delegation = delegation;
    repository = repository;
    connector = connector;
    title = title;
    body = body;
    status = RequestStatus.READY;
  }
}

action requestPullRequest @stableId("act_c4bb8af190dd48efb9784efb9ff9030c")(
  caller actor: Principal,
  delegation: Delegation,
  repository: Repository,
  connector: Connector,
  headBranch: String,
  baseBranch: String,
  title: String
) -> PullRequest {
  authorize PullRequestDelegation(actor, delegation, repository, connector);
  idempotency required;

  create PullRequest {
    org = actor.org;
    requestedBy = actor;
    delegation = delegation;
    repository = repository;
    connector = connector;
    headBranch = headBranch;
    baseBranch = baseBranch;
    title = title;
    status = RequestStatus.READY;
  }
}

action requestStagingDeployment @stableId("act_1388eb9f38684fa0830f60156cdba497")(
  caller actor: Principal,
  delegation: Delegation,
  environment: Environment,
  connector: Connector,
  commitSha: String
) -> DeploymentRequest {
  authorize StagingDeployDelegation(actor, delegation, environment, connector);
  require staging_target: environment.tier == EnvironmentTier.STAGING;
  idempotency required;

  create DeploymentRequest {
    org = actor.org;
    requestedBy = actor;
    delegation = delegation;
    environment = environment;
    environmentTier = environment.tier;
    connector = connector;
    commitSha = commitSha;
    status = RequestStatus.READY;
    approvedBy = null;
    approvedByRoles = null;
  }
}

action requestProductionDeployment @stableId("act_d10d1618ed4045f396b64fc3745ce3dd")(
  caller actor: Principal,
  delegation: Delegation,
  environment: Environment,
  connector: Connector,
  commitSha: String
) -> DeploymentRequest {
  authorize ProductionDeployDelegation(actor, delegation, environment, connector);
  require production_target: environment.tier == EnvironmentTier.PRODUCTION;
  idempotency required;

  create DeploymentRequest {
    org = actor.org;
    requestedBy = actor;
    delegation = delegation;
    environment = environment;
    environmentTier = environment.tier;
    connector = connector;
    commitSha = commitSha;
    status = RequestStatus.PENDING_APPROVAL;
    approvedBy = null;
    approvedByRoles = null;
  }
}

action requestSchemaMigration @stableId("act_411bfff32560406186bd2d442f1ecf3b")(
