    and delegation.capability == Capability.OPEN_PULL_REQUEST
    and delegation.repository == repository
    and delegation.connector == connector
    and repository.connector == connector
    and delegation.org == actor.org
    and repository.org == actor.org
    and connector.org == actor.org;
}

