  status: RequestStatus = RequestStatus.READY @stableId("fld_658bfd33302b4a6e996a88d746572ec2");

  invariant direct_request_status @stableId("inv_eb91ccea513d43f4b7ae0e96f4f25ef9"):
    status == RequestStatus.READY or status == RequestStatus.DISPATCHED;
}

// One typed request supports staging and production, with the tier snapshotted so
// approval invariants remain local and therefore compile to PostgreSQL checks.
entity DeploymentRequest @tenantScoped(org) @stableId("ent_e2b5ba3cccef437796b2048fd1ff2f24") {
  id: UUID @id @generated(uuid) @immutable @stableId("fld_adecbdc3c4cb4bbb8b4e528dbc7408a5");
  createdAt: DateTime @generated(now) @immutable @stableId("fld_90575438c6e94deab4c8e6948e68345b");
  org: Organization @immutable @stableId("fld_c9d0dea7ee234d18824faaed519bff81");
  requestedBy: Principal @immutable @stableId("fld_c3b2af2fa9ab4b29bfaa4e030bee1562");
  delegation: Delegation @immutable @stableId("fld_129c498eb5ab4650aa2f5032427a5045");
  environment: Environment @immutable @stableId("fld_f70e0428ad644adc8f1ec755350ad645");
  environmentTier: EnvironmentTier @snapshot @stableId("fld_0be25eb7ee834d4e845535e6d3c9d0fe");
  connector: Connector @immutable @stableId("fld_a639788198e34e8694774dd0e3208d7d");
  commitSha: String @immutable @stableId("fld_dd3ada66cf6b49b5a37ab5fcba85fb85");
  status: RequestStatus @stableId("fld_d905a7f0828849ae855fbbd30aad5255");
  approvedBy: Principal? @stableId("fld_da7706d558434a06b10cfa548972efa6");
  approvedByRoles: Set<Role>? @snapshot @stableId("fld_d82dc0f1c8fc4accacdc742dd0258ac6");

  invariant tier_controls_lifecycle @stableId("inv_6bca35ccc0804598a347f1fe7fcc87d2"):
    (
      environmentTier == EnvironmentTier.STAGING
      and (status == RequestStatus.READY or status == RequestStatus.DISPATCHED)
    )
    or
    (
      environmentTier == EnvironmentTier.PRODUCTION
      and (
        status == RequestStatus.PENDING_APPROVAL
        or status == RequestStatus.APPROVED
        or status == RequestStatus.REJECTED
        or status == RequestStatus.DISPATCHED
      )
    );

  invariant approval_fields_match_status @stableId("inv_ff4e5164d93f4c67b0be7af34ed228d7"):
    (
      environmentTier == EnvironmentTier.PRODUCTION
      and (status == RequestStatus.APPROVED or status == RequestStatus.DISPATCHED)
      and approvedBy != null
      and approvedByRoles != null
    )
    or
    (
      (environmentTier == EnvironmentTier.STAGING
        or status == RequestStatus.PENDING_APPROVAL
        or status == RequestStatus.REJECTED)
      and approvedBy == null
      and approvedByRoles == null
    );

  invariant approver_differs_from_requester @stableId("inv_a981bd3d01714dd489b3159dfddf6e31"):
    (approvedBy == null) or approvedBy != requestedBy;

  invariant approval_authority_recorded @stableId("inv_1be7fd43c4ab4198ab733fbeb8fd7d44"):
    (approvedByRoles == null) or Role.APPROVER in approvedByRoles;
}

entity SchemaMigrationRequest @stableId("ent_c136762ce9794a7b92ca3c138c7c7bef") @tenantScoped(org) {
  id: UUID @id @generated(uuid) @immutable @stableId("fld_6220c184797043188c546747a102e097");
  createdAt: DateTime @generated(now) @immutable @stableId("fld_001992183e08454d9235ad39cc6a4f56");
  org: Organization @immutable @stableId("fld_c7eac19396da4475916b33163d6ecd9f");
  requestedBy: Principal @immutable @stableId("fld_4acc8ceaf7b04e0680ef41cc4d2f1267");
  delegation: Delegation @immutable @stableId("fld_6f6a4d54c6d944069845e8f582aaf69d");
  environment: Environment @immutable @stableId("fld_25c4ef24ca5f40608a160eaa8ce47613");
  connector: Connector @immutable @stableId("fld_3b91f96763da4611a09ec9774b3fde7b");
  migrationName: String @immutable @stableId("fld_2a58885ca7404655a635e2bca9379202");
  migrationSha: String @immutable @stableId("fld_9d6644545b0d47fbbe8d2699f202160b");
  status: RequestStatus = RequestStatus.PENDING_APPROVAL @stableId("fld_9652d13eff5e44a59f102d58156ed82d");
  approvedBy: Principal? @stableId("fld_9228edae7b7a4368ad3deaf385872789");
  approvedByRoles: Set<Role>? @snapshot @stableId("fld_d36093e299fc4f169da9855783368ad5");

  invariant migration_lifecycle @stableId("inv_c3643a3b1ad24276a883a17ef432bc69"):
    status == RequestStatus.PENDING_APPROVAL
    or status == RequestStatus.APPROVED
    or status == RequestStatus.REJECTED
    or status == RequestStatus.DISPATCHED;

  invariant approval_fields_match_status @stableId("inv_86b577f6815d4b93b563323269aa7d59"):
    (
      (status == RequestStatus.APPROVED or status == RequestStatus.DISPATCHED)
      and approvedBy != null
      and approvedByRoles != null
    )
    or
    (
      (status == RequestStatus.PENDING_APPROVAL or status == RequestStatus.REJECTED)
      and approvedBy == null
      and approvedByRoles == null
    );

  invariant approver_differs_from_requester @stableId("inv_d4a6e35e5ca24569b8a7d9287154d249"):
    (approvedBy == null) or approvedBy != requestedBy;

  invariant approval_authority_recorded @stableId("inv_d46ef40323b64ea1913f20ef51989bfd"):
    (approvedByRoles == null) or Role.APPROVER in approvedByRoles;
}

entity Approval @tenantScoped(org) @stableId("ent_f6f083c592f34c07af0204bb507be013") {
  id: UUID @id @generated(uuid) @immutable @stableId("fld_d76e45f665d140d29821a79fe8cf0d57");
  decidedAt: DateTime @generated(now) @immutable @stableId("fld_a9a2a789b7d74ca2971ab753ab9e9ab3");
