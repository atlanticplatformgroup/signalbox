query myIssueRequests @stableId("qry_22f082ad9148490eb301e04fdc6e2ce3")(caller actor: Principal) returns IssueRequestSummary from IssueRequest as request {
  authorize true;
  where request.org == actor.org;
  orderBy request.id asc;
  limit 50;
  paginate cursor;
  audit reads;
}

query myPullRequests @stableId("qry_a96d198b028c45f2b0ec43471cb5ba09")(caller actor: Principal) returns PullRequestSummary from PullRequest as request {
  authorize true;
  where request.org == actor.org;
  orderBy request.id asc;
  limit 50;
  paginate cursor;
  audit reads;
}

query myDeploymentRequests @stableId("qry_60d1c5d416eb428caa385db274edcb4b")(
  caller actor: Principal
) returns DeploymentRequestSummary from DeploymentRequest as request {
  authorize true;
  where request.org == actor.org;
  orderBy request.id asc;
