  audit reads;
}

query migrationApprovalInbox @stableId("qry_8a136078ed3b4ee6893410b631ac5a04")(
  caller actor: Principal
) returns SchemaMigrationSummary from SchemaMigrationRequest as request {
  authorize
    actor.kind == PrincipalKind.HUMAN
    and Role.APPROVER in actor.roles;
  where request.org == actor.org
    and request.status == RequestStatus.PENDING_APPROVAL
    and request.requestedBy != actor;
  orderBy request.id asc;
  limit 50;
  paginate cursor;
  audit reads;
}

query myExecutions @stableId("qry_e608c643d17c4a908f26e6a538630a51")(caller actor: Principal) returns ExecutionSummary from Execution as execution {
  authorize true;
  where execution.org == actor.org;
  orderBy execution.id asc;
  limit 50;
  paginate cursor;
  audit reads;
}
