  REVOKED @stableId("emv_37139bd7991e42ed90815cacee1b9adc")
}

enum EnvironmentTier @stableId("enm_380f40ed4b084a67944e5f793458621d") {
  STAGING @stableId("emv_755e07c678b947119388106756bf7f0d"),
  PRODUCTION @stableId("emv_6c5e03a32f0a410785d2bba34a83ff21")
}

enum Capability @stableId("enm_8381729a6ae947c885585318421c3883") {
  CREATE_ISSUE @stableId("emv_1d2efe651ad14d9ab7c95e7156f9dd7d"),
  OPEN_PULL_REQUEST @stableId("emv_adb9bc0c4c804c209b6a16e2c040235e"),
  DEPLOY_STAGING @stableId("emv_f2c9d52d03e24e409ae47104d23b1ef5"),
  REQUEST_PRODUCTION_DEPLOY @stableId("emv_b6af2941a9904877944e278153abca35"),
  REQUEST_SCHEMA_MIGRATION @stableId("emv_2311b8cbff0749938fad96ade786c16c")
}

enum DelegationStatus @stableId("enm_82705b31f72f487b9f0af8726779ea39") {
  ACTIVE @stableId("emv_740011172f05480b9606af59979e50ce"),
  REVOKED @stableId("emv_b37edfd22dda455b8aee5a11238b8a39")
}

enum RequestStatus @stableId("enm_62bc5aa58efc405398d2931c339c730c") {
  READY @stableId("emv_d184c3fad73845198cae3b13e7648218"),
  PENDING_APPROVAL @stableId("emv_68cab0efe9654fce9b385cede2f85e9d"),
