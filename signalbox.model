  org: Organization @immutable @stableId("fld_a07af94c649f43379bb186f5d102939f");
  repository: Repository @immutable @stableId("fld_e4609189f57a447a908833c1fd147f6b");
  connector: Connector @immutable @stableId("fld_52304449caa54a5c8ea478cde23883a0");
  name: String @stableId("fld_d7283a03833947b99224118cac98cf46");
  tier: EnvironmentTier @immutable @stableId("fld_85e49c361751417686fab601b59b541b");
}

// A delegation scopes one agent capability to one repository or environment and
// to the exact connector that will perform the eventual external effect.
entity Delegation @tenantScoped(org) @stableId("ent_accc8ba6b5ae4d76813eb983c3d1f8ce") {
  id: UUID @id @generated(uuid) @immutable @stableId("fld_776b40619c354d4b93a2eeec5f6cc254");
  org: Organization @immutable @stableId("fld_57535d45b9bc42ccb9b9bed2c77a8996");
  agent: Principal @immutable @stableId("fld_054b2d41511b413cb6928aa459d34e60");
  capability: Capability @immutable @stableId("fld_cc8b5256189f47279d51704215aaae8f");
  repository: Repository? @immutable @stableId("fld_7d35f99f78c84d67af4d094e0eea9a27");
  environment: Environment? @immutable @stableId("fld_5baad9f56824417b8743b7cc93b32007");
  connector: Connector @immutable @stableId("fld_a67128763ffa463b819aa6f5c8fe5729");
  status: DelegationStatus = DelegationStatus.ACTIVE @stableId("fld_3e25eaed78c54f1e893497b8af2045a1");

  invariant resource_scope_matches_capability @stableId("inv_1a0e2ae84b1c4512b89871065e0b8e8d"):
    (
      (capability == Capability.CREATE_ISSUE or capability == Capability.OPEN_PULL_REQUEST)
      and repository != null
      and environment == null
    )
    or
    (
      (
        capability == Capability.DEPLOY_STAGING
        or capability == Capability.REQUEST_PRODUCTION_DEPLOY
        or capability == Capability.REQUEST_SCHEMA_MIGRATION
      )
      and repository == null
      and environment != null
    );
}

// Budget is a set of pre-issued, agent-scoped consumption tokens. Execution has
// a unique allowance reference, so one token can never be spent twice.
entity Allowance @tenantScoped(org) @stableId("ent_b0fd2128e94a469089ac56c643cc4e36") {
  id: UUID @id @generated(uuid) @immutable @stableId("fld_4669d240de76491f918160af4833ca73");
  org: Organization @immutable @stableId("fld_059d2ddcea884369a05e172746ce56ee");
  agent: Principal @immutable @stableId("fld_73260390a96241b4b94137e53ed48792");
  period: String @immutable @stableId("fld_9e4882e18d894214b52e6dcde5e92efc");
  sequence: Int @immutable @stableId("fld_a87e7d4bc69d4343b5aa2e955bed21a3");
}

entity IssueRequest @stableId("ent_d66226c7efc345ba9853df0d4abb879a") @tenantScoped(org) {
